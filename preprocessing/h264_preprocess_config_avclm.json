{
  "width": 256,
  "height": 144,
  "resize_mode": "scale_pad",
  "resize_mode_comment": "AVC-LM: fit within 256x144 preserving aspect ratio, then pad (letterbox/pillarbox).",
  "fps": 3,
  "clip_duration_sec": 5,
  "clip_duration_comment": "AVC-LM caps each clip at 5s (-t 5). At fps 3 that is ~15 frames.",
  "rate_control": "qp",
  "qp": 37,
  "crf": null,
  "gop": 16,
  "preset": "veryfast",
  "video_extensions": [".mp4", ".mov", ".mkv", ".webm", ".avi"],
  "ffmpeg": {
    "binary": "ffmpeg",
    "ffprobe_binary": "ffprobe",
    "codec": "libx264",
    "format": "h264",
    "profile": "baseline",
    "level": null,
    "pix_fmt": "yuv420p",
    "disable_audio": true,
    "disable_subtitles": true,
    "disable_bframes": true,
    "refs": 3,
    "scene_cut_threshold": 0,
    "threads": 1,
    "timeout_sec": 300,
    "bitstream_filter": null,
    "bitstream_filter_comment": "AVC-LM uses -bsf:v h264_mp4toannexb for mp4-muxed output; our raw -f h264 muxer is already Annex-B, so leave off.",
    "x264_params": {
      "cabac": 0,
      "repeat-headers": 1,
      "aud": 0,
      "slice-max-mbs": 1,
      "trellis": 0,
      "me": "dia",
      "subme": 0,
      "psy": 0,
      "mixed-refs": 0,
      "fast-pskip": 0,
      "partitions": "none"
    }
  }
}
